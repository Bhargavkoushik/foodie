# Foodie Frontend Environment Configuration (Vite)

# Backend API base URL
# For production (set this in your Vercel Project Settings -> Environment Variables):
VITE_BACKEND_URL=https://foodie-nzkz.onrender.com

# For local development (uncomment if running local backend):
# VITE_BACKEND_URL=http://localhost:4000

# Optional Gemini API key for the AI Chatbot feature
# VITE_GEMINI_API_KEY=your_gemini_api_key_here
