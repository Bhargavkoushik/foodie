# Foodie Backend Environment Configuration
PORT=4000

# MongoDB Connection String:
# For Local Development:
# MONGODB_URI=mongodb://localhost:27017/foodie
# For Production (MongoDB Atlas):
# Format: mongodb+srv://<username>:<url_encoded_password>@<cluster>.mongodb.net/foodie?appName=Cluster0
MONGODB_URI=mongodb+srv://<username>:<db_password>@cluster0.xxxxx.mongodb.net/foodie?retryWrites=true&w=majority&appName=Cluster0

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here

# Seed Admin Credentials (used by npm run seed:admin)
ADMIN_EMAIL=admin@foodie.com
ADMIN_PASSWORD=your_secure_admin_password

# Client URLs (for CORS in production)
FRONTEND_URL=https://foodie-cyan-alpha.vercel.app
CLIENT_URL=https://foodie-cyan-alpha.vercel.app

